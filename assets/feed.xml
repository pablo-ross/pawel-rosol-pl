---
layout: compress
permalink: /feed.xml
# Atom Feed, reference: https://validator.w3.org/feed/docs/atom.html
#
# OVERRIDE of jekyll-theme-chirpy's assets/feed.xml (see CLAUDE.md). Two changes
# from the gem's version, both marked below: the entry limit, and the author name.
# Re-diff against the gem on every theme upgrade.
#
# Do NOT add `{{ post.content }}` here without first removing the global
# `replace: '&', '&amp;'` on the last line — it would double-escape every
# entity in the document and break the feed.
---

{% capture source %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ "/" | absolute_url }}</id>
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.social.name }}</name>
    <uri>{{ "/" | absolute_url }}</uri>
  </author>
  <link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url }}"/>
  <link rel="alternate" type="text/html" hreflang="{{ site.alt_lang | default: site.lang }}"
    href="{{ '/' | absolute_url }}"/>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <rights> © {{ 'now' | date: '%Y' }} {{ site.social.name }} </rights>
  <icon>{{ site.baseurl }}/assets/img/favicons/favicon.ico</icon>
  <logo>{{ site.baseurl }}/assets/img/favicons/favicon-96x96.png</logo>

{%- comment -%}override: was `limit: 5`{%- endcomment -%}
{% for post in site.posts limit: 20 %}
  {% assign post_absolute_url = post.url | absolute_url %}
  <entry>
    <title>{{ post.title }}</title>
    {%- comment -%}override: `xml_escape` here is double-escaped by the global `replace: '&', '&amp;'` below — a title with an apostrophe rendered as `&amp;apos;`. Ampersands are handled globally, as they already are for the <title> element.{%- endcomment -%}
    <link href="{{ post_absolute_url }}" rel="alternate" type="text/html" title="{{ post.title }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
  {% if post.last_modified_at %}
    <updated>{{ post.last_modified_at | date_to_xmlschema }}</updated>
  {% else %}
    <updated>{{ post.date | date_to_xmlschema }}</updated>
  {% endif %}
    <id>{{ post_absolute_url }}</id>
    <content type="text/html" src="{{ post_absolute_url }}" />
    <author>
      {%- comment -%}override: resolve the author id to a display name{%- endcomment -%}
      <name>{{ site.data.authors[post.author].name | default: site.social.name }}</name>
      {%- if site.data.authors[post.author].url %}
      <uri>{{ site.data.authors[post.author].url }}</uri>
      {%- endif %}
    </author>

  {% if post.categories %}
    {% for category in post.categories %}
    <category term="{{ category }}" />
    {% endfor %}
  {% endif %}

  <summary>{% include post-summary.html max_length=400 %}</summary>

  </entry>
{% endfor %}
</feed>
{% endcapture %}
{{ source | replace: '&', '&amp;' }}
