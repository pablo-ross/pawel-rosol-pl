# Server behaviour for pawel.rosol.pl on mydevil.net.
#
# mydevil serves PHP-type sites through nginx with an in-house .htaccess
# module, so only the directives its documentation lists are safe here:
# https://pomoc.mydevil.net/htaccess/
# A syntax error in this file returns 500 for the whole site. To roll back,
# delete it and redeploy.
#
# Jekyll skips dotfiles, so this file is deployed only because `include:` in
# _config.yml names it.

# --- Force HTTPS -----------------------------------------------------------
# Plain HTTP used to answer 200, which left every page reachable unencrypted
# and duplicated. The ACME exception keeps Let's Encrypt renewals working over
# HTTP, which is where the http-01 challenge is fetched.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- Character encoding ----------------------------------------------------
# llms.txt and security.txt are served as text/plain with no charset, which
# mangles Polish diacritics. HTML carries its own meta charset and is
# unaffected.
AddDefaultCharset utf-8

# --- Content-Security-Policy -----------------------------------------------
# Derived from what the build actually loads, not from a template. Re-derive it
# after a theme upgrade or a new embed; tools/check-csp.rb fails the build if an
# inline script appears whose hash is not listed here, or if a page starts
# loading a host the policy does not name.
#
# Since assets.self_host was switched on and the last two embeds were dropped,
# the site loads nothing from a third party: every directive is 'self'.
#
#   script-src  one inline script (Chirpy's search init, identical on all pages)
#               is allowed by hash, so 'unsafe-inline' is not needed and an
#               injected <script> cannot run
#   style-src   'unsafe-inline' is still required: glightbox sets style
#               attributes and injects a <style> element at runtime. The build
#               itself ships no <style> block and no style= attribute, so this
#               is the one directive that could tighten if the lightbox ever
#               stopped doing that
#   frame-src   'none' - the site embeds nothing
#   img-src     data: covers one inline SVG in the theme's stylesheet
#   upgrade-insecure-requests  belt and braces next to the HTTPS redirect
Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; frame-src 'none'; form-action 'self'; script-src 'self' 'sha256-kN/QDj91CKyOGZ/x3hqqrHGFh0tFZfLJ1vyeIbo7Cuo='; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests"

# --- Other security headers ------------------------------------------------
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-Frame-Options "SAMEORIGIN"
Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"

# --- Caching ---------------------------------------------------------------
# GZIP is already on at the panel (devil www options ... gzip), and Chirpy
# already minifies the HTML and ships minified CSS/JS, so the remaining win on
# repeat visits is not re-sending bytes that have not changed.
#
# None of the theme's asset filenames carry a content hash, so a long cache on
# CSS/JS would serve a stale theme after a deploy. One day is short enough to
# propagate quickly while still saving the request; ETag and Last-Modified
# still allow a 304 on everything below.
<FilesMatch "\.(html|xml|json|txt|webmanifest)$">
  Header set Cache-Control "max-age=0, must-revalidate"
</FilesMatch>
<FilesMatch "\.(css|js)$">
  Header set Cache-Control "max-age=86400, public"
</FilesMatch>
<FilesMatch "\.(woff2|woff|ttf|eot|otf)$">
  Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>
<FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
  Header set Cache-Control "max-age=2592000, public"
</FilesMatch>

# --- Directory listings ----------------------------------------------------
Options -Indexes
