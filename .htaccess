# Server behaviour for pawel.rosol.pl on mydevil.net.
#
# mydevil serves PHP-type sites through nginx with an in-house .htaccess
# module, so only the directives its documentation lists are safe here:
# https://pomoc.mydevil.net/htaccess/
# A syntax error in this file returns 500 for the whole site. To roll back,
# delete it and redeploy.
#
# Jekyll skips dotfiles, so this file is deployed only because `include:` in
# _config.yml names it.

# --- Force HTTPS -----------------------------------------------------------
# Plain HTTP used to answer 200, which left every page reachable unencrypted
# and duplicated. The ACME exception keeps Let's Encrypt renewals working over
# HTTP, which is where the http-01 challenge is fetched.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# --- Character encoding ----------------------------------------------------
# llms.txt and security.txt are served as text/plain with no charset, which
# mangles Polish diacritics. HTML carries its own meta charset and is
# unaffected.
AddDefaultCharset utf-8

# --- Content-Security-Policy -----------------------------------------------
# Derived from what the build actually loads, not from a template. Re-derive it
# after a theme upgrade or a new embed; tools/check-csp.rb fails the build if an
# inline script appears whose hash is not listed here.
#
#   script-src  one inline script (Chirpy's search init, identical on all pages)
#               is allowed by hash, so 'unsafe-inline' is not needed and an
#               injected <script> cannot run
#   style-src   'unsafe-inline' is unavoidable: the Twitter widget injects
#               styles at runtime. Far less dangerous than script 'unsafe-inline'
#   twimg/twitter, docdroid  two 2020 posts embed a tweet and a PDF viewer
#   upgrade-insecure-requests  belt and braces next to the HTTPS redirect
Header set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'sha256-kN/QDj91CKyOGZ/x3hqqrHGFh0tFZfLJ1vyeIbo7Cuo=' https://cdn.jsdelivr.net https://platform.twitter.com https://cdn.syndication.twimg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com; img-src 'self' data: https://pbs.twimg.com https://abs.twimg.com https://syndication.twitter.com; frame-src https://platform.twitter.com https://syndication.twitter.com https://www.docdroid.net; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests"

# --- Other security headers ------------------------------------------------
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set X-Frame-Options "SAMEORIGIN"
Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"

# --- Directory listings ----------------------------------------------------
Options -Indexes
